COMPOSE_PROJECT_NAME=skygo-admin-web
ADMIN_WEB_IMAGE=ghcr.io/alpha2z/skygo-admin/admin-web:latest
ADMIN_WEB_BIND=127.0.0.1
ADMIN_WEB_PORT=18390
# Existing network shared with API; no API container is created here.
ADMIN_NETWORK=skygo-admin
# Scheme + hostname + port, no path, query or credentials.
ADMIN_API_ORIGIN=http://admin-api:18391
