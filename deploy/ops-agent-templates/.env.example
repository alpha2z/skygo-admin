COMPOSE_PROJECT_NAME=skygo-ops-agent
OPS_AGENT_IMAGE=ghcr.io/alpha2z/skygo-admin/ops-agent:latest
# Absolute host path containing explicitly managed Compose deployments.
MANAGED_DEPLOYMENTS_DIR=/opt/skygo-admin

# Pin the already imported transitional image; Agent updates never change this.
OPS_UPDATER_IMAGE=
DOCKER_ROOT_DIR=/var/lib/docker
