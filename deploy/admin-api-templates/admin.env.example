# Container paths, not host paths. Mount ./private at /run/private read-only.
ADMIN_LISTEN_ADDRESS=0.0.0.0:18391
ADMIN_MYSQL_DSN_FILE=/run/private/management-dsn
ADMIN_JWT_SECRET_FILE=/run/private/jwt
ADMIN_BOOTSTRAP_TOKEN_FILE=/run/private/bootstrap
ADMIN_SIGNING_KEY_FILE=/run/private/signing

# Production browser access must use HTTPS.
ADMIN_COOKIE_SECURE=true
ADMIN_TOTP_ENABLED=true
ADMIN_EMAIL_CONFIRMATION_ENABLED=true
ADMIN_SMTP_ADDRESS=smtp.example.net:587
ADMIN_SMTP_USERNAME=admin-notifications@example.net
ADMIN_SMTP_FROM=admin-notifications@example.net
ADMIN_SMTP_PASSWORD_FILE=/run/private/smtp-password

# Optional: enable only after setting up the integration files.
# ADMIN_GITHUB_CONFIG=/run/private/github.json
# Optional: trust only the actual reverse proxy address/subnet.
# ADMIN_TRUSTED_PROXY_CIDRS=172.30.81.10/32
