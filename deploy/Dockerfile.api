FROM --platform=$BUILDPLATFORM golang:1.25.5-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN GOWORK=off go mod download
COPY cmd ./cmd
COPY internal ./internal
COPY admin ./admin
COPY agent ./agent
COPY control ./control
COPY web ./web
COPY admin-web ./admin-web
ARG TARGETOS
ARG TARGETARCH
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH GOWORK=off go build -trimpath -o /admin-api ./cmd/admin-api
FROM alpine:3.23
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 admin
WORKDIR /app
COPY --from=build /admin-api /usr/local/bin/admin-api
COPY admin-web /app/admin-web
USER 10001
ENTRYPOINT ["admin-api"]
