{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Data provider contract v1",
  "oneOf": [
    {
      "$ref": "#/$defs/catalog"
    },
    {
      "$ref": "#/$defs/result"
    }
  ],
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "enum": [
            "string",
            "number",
            "boolean"
          ]
        }
      },
      "required": [
        "id",
        "title",
        "type"
      ]
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "title": {
          "type": "string"
        },
        "unit": {
          "type": "string"
        },
        "modes": {
          "type": "array",
          "items": {
            "enum": [
              "current",
              "series",
              "rows"
            ]
          },
          "maxItems": 3
        },
        "dimensions": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,47}$"
          },
          "maxItems": 32
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/field"
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "title",
        "unit",
        "modes",
        "dimensions"
      ]
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "dataset": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "kind": {
          "enum": [
            "card",
            "chart",
            "table"
          ]
        },
        "title": {
          "type": "string"
        }
      },
      "required": [
        "dataset",
        "kind",
        "title"
      ]
    },
    "panel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,47}$"
        },
        "title": {
          "type": "string"
        },
        "widgets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/widget"
          },
          "maxItems": 32
        }
      },
      "required": [
        "id",
        "title",
        "widgets"
      ]
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "datasets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dataset"
          },
          "maxItems": 64
        },
        "panels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/panel"
          },
          "maxItems": 16
        }
      },
      "required": [
        "version",
        "datasets",
        "panels"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "value"
      ]
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "at": {
          "type": "string",
          "format": "date-time"
        },
        "value": {
          "type": [
            "number",
            "null"
          ]
        }
      },
      "required": [
        "at",
        "value"
      ]
    },
    "series": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point"
          },
          "maxItems": 1000
        }
      },
      "required": [
        "points"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "version": {
          "const": 1
        },
        "sampled_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "ok",
            "partial",
            "stale",
            "unavailable"
          ]
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "maxItems": 32
        },
        "values": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/value"
          },
          "maxItems": 100
        },
        "series": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/series"
          },
          "maxItems": 10
        },
        "rows": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": {
              "type": [
                "string",
                "number",
                "boolean",
                "null"
              ]
            }
          },
          "maxItems": 100
        },
        "total": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "sampled_at",
        "state",
        "warnings"
      ]
    }
  }
}
